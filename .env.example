# =============================================================================
# Omi environment variables
# Copy to `.env` at the repo root. Apps load via `dotenv -e ../../.env`.
# Convex dashboard env vars must mirror the Convex section below.
# =============================================================================

# -----------------------------------------------------------------------------
# Convex (local dev + deploy)
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=""
CONVEX_URL=""
CONVEX_SITE_URL=""
# CI/production deploy only:
# CONVEX_DEPLOY_KEY=""

# -----------------------------------------------------------------------------
# Main app (apps/app) — Vite client + TanStack Start server
# -----------------------------------------------------------------------------
VITE_CONVEX_URL=""
VITE_CONVEX_SITE_URL=""
VITE_SITE_URL="https://app.omi.ac"
VITE_SENTRY_DSN=""
# Comma-separated Chrome extension IDs allowed for /connect-extension
# VITE_EXTENSION_ID_ALLOWLIST=""

# Server-side Sentry (instrument.server.mjs); falls back to VITE_SENTRY_DSN
# SENTRY_DSN=""
# Source map upload during build (CI)
# SENTRY_AUTH_TOKEN=""

# Product analytics (apps/app)
# VITE_POSTHOG_KEY=""
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# -----------------------------------------------------------------------------
# Marketing site (apps/web)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL="https://app.omi.ac"

# -----------------------------------------------------------------------------
# Browser extension (apps/extension)
# -----------------------------------------------------------------------------
# VITE_SITE_URL="https://app.omi.ac"

# -----------------------------------------------------------------------------
# Convex backend — set in Convex dashboard (and root .env for local dev)
# -----------------------------------------------------------------------------

# Auth (better-auth)
SITE_URL="https://app.omi.ac"
JWKS=""

# Email (Resend via @convex-dev/resend)
EMAIL_DOMAIN=""
# RESEND_API_KEY=""  # configured in Convex dashboard for the Resend component

# AI
OPENAI_API_KEY=""

# Encryption
OMI_TOKEN_KEY=""              # 32-byte key, base64 — OAuth connection tokens
BYO_KEY_ENCRYPTION_KEY=""     # 32-byte key, base64 — workspace BYO API keys
OAUTH_STATE_SECRET=""         # min 16 chars — OAuth CSRF state signing

# Stripe billing (optional locally; required in production)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_BASIC_MONTHLY=""
# STRIPE_PRICE_BASIC_YEARLY=""
# STRIPE_PRICE_PRO_MONTHLY=""
# STRIPE_PRICE_PRO_YEARLY=""

# OAuth — sign-in providers
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# OAuth — integrations (connections)
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# NOTION_WEBHOOK_TOKEN=""
# GOOGLE_DRIVE_CLIENT_ID=""
# GOOGLE_DRIVE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_SCOPES="repo"
# LINEAR_CLIENT_ID=""
# LINEAR_CLIENT_SECRET=""

# Website capture (Cloudflare Browser Rendering)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=""

# AI reranking (optional — enables Cohere rerank in search/chat)
# COHERE_API_KEY=""

# -----------------------------------------------------------------------------
# CI / Turbo (optional)
# -----------------------------------------------------------------------------
# TURBO_TEAM=""
# TURBO_TOKEN=""
